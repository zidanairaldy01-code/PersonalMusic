{
  "version": 2,
  "routes": [
    {
      "src": "/",
      "dest": "/public/index-static.html"
    },
    {
      "src": "/index-static.html",
      "dest": "/public/index-static.html"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/public/storage/$1"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|mp3|wav|ogg|mpeg|webp))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index-static.html"
    }
  ]
}
